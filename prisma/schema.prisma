generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoStorageStatus {
  LOCAL
  UPLOADING
  READY
  FAILED
}

enum LiveSessionStatus {
  PREPARING
  LIVE
  ENDED
  FAILED
}

enum LiveSourceType {
  BROWSER_CAMERA
  EXTERNAL_ENCODER
}

enum RecordingSegmentStatus {
  UPLOADING
  READY
  FAILED
}

enum PlaylistVisibility {
  PERSONAL
  WORKSPACE
}

model User {
  id                   String              @id @default(cuid())
  name                 String
  username             String              @unique
  email                String?             @unique
  passwordHash         String?
  mustChangePassword   Boolean             @default(true)
  role                 String              @default("analyst")
  workspaceId          String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  workspace            Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  presences            WorkspacePresence[]
  createdMoments       Moment[]            @relation("MomentCreatedBy")
  createdPlayerActions PlayerAction[]      @relation("PlayerActionCreatedBy")
  startedLiveSessions  LiveSession[]       @relation("LiveSessionStartedBy")
  playlists            Playlist[]
  createdInvites       WorkspaceInvite[]   @relation("InviteCreatedBy")
  claimedInvites       WorkspaceInvite[]   @relation("InviteClaimedBy")

  @@index([workspaceId])
}

model Workspace {
  id                        String              @id @default(cuid())
  name                      String
  managementPasswordHash    String?
  managementPasswordVersion Int                 @default(0)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  users                     User[]
  seasons                   Season[]
  players                   Player[]
  trainings                 Training[]
  momentTypes               MomentType[]
  presences                 WorkspacePresence[]
  playlists                 Playlist[]
  invites                   WorkspaceInvite[]
}

model WorkspaceInvite {
  id              String    @id @default(cuid())
  workspaceId     String
  codeHash        String    @unique
  role            String    @default("analyst")
  createdByUserId String
  claimedByUserId String?
  expiresAt       DateTime
  claimedAt       DateTime?
  createdAt       DateTime  @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User      @relation("InviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  claimedBy       User?     @relation("InviteClaimedBy", fields: [claimedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, expiresAt])
}

model WorkspacePresence {
  id                      String       @id @default(cuid())
  workspaceId             String
  userId                  String
  clientId                String
  lastSeenAt              DateTime
  liveSessionId           String?
  playbackPositionSeconds Float?
  atLiveEdge              Boolean      @default(true)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  workspace               Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  liveSession             LiveSession? @relation(fields: [liveSessionId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, clientId])
  @@index([workspaceId, lastSeenAt])
  @@index([userId])
  @@index([liveSessionId, lastSeenAt])
}

model Season {
  id          String     @id @default(cuid())
  name        String
  workspaceId String
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  trainings   Training[]
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Player {
  id          String           @id @default(cuid())
  name        String
  shirtNumber Int?
  position    String?
  active      Boolean          @default(true)
  workspaceId String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  trainings   TrainingPlayer[]
  actions     PlayerAction[]

  @@unique([workspaceId, name])
  @@index([workspaceId, active])
}

model Training {
  id                 String           @id @default(cuid())
  title              String
  season             String
  microcycleNumber   Int
  trainingUnitNumber Int
  trainingDate       DateTime
  notes              String?
  seasonId           String
  workspaceId        String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  video              Video?
  moments            Moment[]
  playerActions      PlayerAction[]
  exercises          Exercise[]
  participants       TrainingPlayer[]
  liveSessions       LiveSession[]
  seasonRecord       Season           @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, seasonId, microcycleNumber, trainingUnitNumber])
  @@index([workspaceId, trainingDate])
  @@index([seasonId])
}

model TrainingPlayer {
  trainingId String
  playerId   String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@id([trainingId, playerId])
  @@index([playerId])
  @@index([trainingId, sortOrder])
}

model Exercise {
  id               String         @id @default(cuid())
  trainingId       String
  number           Int
  startTimeSeconds Float
  endTimeSeconds   Float?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  training         Training       @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  moments          Moment[]
  playerActions    PlayerAction[]

  @@unique([trainingId, number])
  @@index([trainingId, startTimeSeconds])
}

model LiveSession {
  id                 String              @id @default(cuid())
  trainingId         String
  startedByUserId    String
  status             LiveSessionStatus   @default(PREPARING)
  sourceType         LiveSourceType      @default(BROWSER_CAMERA)
  provider           String              @default("segment-dvr")
  providerSessionId  String?
  playbackUrl        String?
  recordingStartedAt DateTime?
  startedAt          DateTime?
  endedAt            DateTime?
  lastSegmentAt      DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  training           Training            @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  startedBy          User                @relation("LiveSessionStartedBy", fields: [startedByUserId], references: [id], onDelete: Restrict)
  segments           RecordingSegment[]
  moments            Moment[]
  playerActions      PlayerAction[]
  presences          WorkspacePresence[]

  @@index([trainingId, status])
  @@index([startedByUserId])
}

model RecordingSegment {
  id               String                 @id @default(cuid())
  liveSessionId    String
  sequence         Int
  startedAtSeconds Float
  durationSeconds  Float?
  storageKey       String                 @unique
  mimeType         String
  fileSize         BigInt?
  status           RecordingSegmentStatus @default(UPLOADING)
  createdAt        DateTime               @default(now())
  readyAt          DateTime?
  liveSession      LiveSession            @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@unique([liveSessionId, sequence])
  @@index([liveSessionId, status, sequence])
}

model Video {
  id              String             @id @default(cuid())
  trainingId      String             @unique
  fileName        String
  fileSize        BigInt
  durationSeconds Float
  mimeType        String
  lastModified    DateTime?
  storageKey      String?            @unique
  storageStatus   VideoStorageStatus @default(LOCAL)
  uploadId        String?
  etag            String?
  uploadedAt      DateTime?
  mediaAssetId    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  training        Training           @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@index([mediaAssetId])
}

model MomentType {
  id              String    @id @default(cuid())
  name            String
  code            String
  workspaceId     String
  color           String
  defaultShortcut String?
  sortOrder       Int       @default(0)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  moments         Moment[]
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, code])
  @@index([workspaceId])
}

model Moment {
  id               String         @id @default(cuid())
  trainingId       String
  momentTypeId     String
  exerciseId       String?
  startTimeSeconds Float
  endTimeSeconds   Float
  durationSeconds  Float
  notes            String?
  outcome          String?
  createdByUserId  String?
  liveSessionId    String?
  markedAtSeconds  Float?
  leadSeconds      Float?         @default(20)
  capturedFromLive Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  training         Training       @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  momentType       MomentType     @relation(fields: [momentTypeId], references: [id])
  exercise         Exercise?      @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  createdBy        User?          @relation("MomentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  liveSession      LiveSession?   @relation(fields: [liveSessionId], references: [id], onDelete: SetNull)
  playlistItems    PlaylistItem[]

  @@index([trainingId])
  @@index([momentTypeId])
  @@index([exerciseId])
  @@index([createdByUserId])
  @@index([liveSessionId, markedAtSeconds])
}

model PlayerAction {
  id               String       @id @default(cuid())
  trainingId       String
  playerId         String
  exerciseId       String?
  startTimeSeconds Float
  endTimeSeconds   Float
  durationSeconds  Float
  notes            String?
  outcome          String?
  createdByUserId  String?
  liveSessionId    String?
  markedAtSeconds  Float?
  leadSeconds      Float?       @default(15)
  capturedFromLive Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  training         Training     @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  player           Player       @relation(fields: [playerId], references: [id], onDelete: Restrict)
  exercise         Exercise?    @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  createdBy        User?        @relation("PlayerActionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  liveSession      LiveSession? @relation(fields: [liveSessionId], references: [id], onDelete: SetNull)

  @@index([trainingId])
  @@index([playerId])
  @@index([exerciseId])
  @@index([createdByUserId])
  @@index([liveSessionId, markedAtSeconds])
}

model Playlist {
  id          String             @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  isDefault   Boolean            @default(false)
  visibility  PlaylistVisibility @default(PERSONAL)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       PlaylistItem[]

  @@unique([userId, name])
  @@index([workspaceId])
  @@index([userId])
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  momentId   String
  note       String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  moment     Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)

  @@unique([playlistId, momentId])
  @@index([momentId])
}
